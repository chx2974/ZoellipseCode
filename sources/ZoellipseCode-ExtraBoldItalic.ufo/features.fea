lookup backslash_slash.liga {
sub @SpaceExlusion SPC slash' @SpaceExlusion by backslash_slash.liga;
sub @SpaceExlusion backslash' slash @SpaceExlusion by SPC;
} backslash_slash.liga;

lookup slash_backslash.liga {
